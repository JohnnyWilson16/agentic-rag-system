# ==============================================================================
# Agentic RAG System - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your preferred LLM provider.
#
# Supported Providers:
#   - groq      (Fastest & Free-tier cloud inference for Llama 3 models)
#   - openai    (GPT-4o, GPT-4o-mini)
#   - gemini    (Google Gemini 1.5/2.0 Flash)
#   - anthropic (Claude 3.5 Sonnet)
#   - ollama    (Local inference if running an Ollama daemon)
# ==============================================================================

# LLM Provider Selection (default: groq)
LLM_PROVIDER=groq

# Model Name (examples below per provider):
# Groq:      groq/llama-3.3-70b-versatile  OR  groq/llama-3.1-8b-instant
# OpenAI:    gpt-4o-mini  OR  gpt-4o
# Gemini:    gemini/gemini-1.5-flash  OR  gemini/gemini-2.0-flash
# Anthropic: anthropic/claude-3-5-sonnet-20241022
# Ollama:    ollama/llama3.2
LLM_MODEL=groq/llama-3.3-70b-versatile

# Provider API Keys (Set the one matching your LLM_PROVIDER)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local Ollama Base URL (Only needed if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Embedding Model (Runs locally via HuggingFace / SentenceTransformers - No API key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Document Ingestion & Chunking Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Vector Store Configuration
VECTOR_STORE_DIR=./company_db
RETRIEVER_K=3

# Execution & Verbosity
VERBOSE=true
